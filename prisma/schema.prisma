// prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Payment {
  id             String        @id @default(uuid())
  paymentId      String        @unique // Razorpay order_id or payment_id
  idempotencyKey String        @unique
  amount         Int           // In paise (e.g. 9900 for ₹99)
  status         String        @default("PENDING") // PENDING, SUCCESS, FAILED
  email          String
  report         Report?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([paymentId])
  @@index([createdAt])
}

model Report {
  id             String       @id @default(uuid())
  token          String       @unique // Cryptographically secure non-sequential token (e.g. ZXA82KLM91PQRT)
  paymentId      String       @unique
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  birthData      String       // Contains JSON serialized month, day, year, hour, minute, ampm, confidence, location, timezone
  type           String       @default("NATAL") // NATAL or SYNASTRY
  partnerData    String?      // Partner's birth data JSON
  synastry       String?      // Computed synastry comparisons
  calculations   String?      // Computed JSON serialized planetary positions
  narrative      String?      // Poetic/psychological JSON serialized interpretations
  status         String       @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED
  pdfUrl         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([token])
  @@index([paymentId])
  @@index([createdAt])
}
